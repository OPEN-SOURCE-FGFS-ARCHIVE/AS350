<?xml version="1.0"?>

<PropertyList>
  <!--  Central warning System -->
  <path>panel.ac</path>

  <animation>
    <type>select</type>
    <object-name>fuel</object-name>
      <condition>
			<less-than>
				<property>consumables/fuel/tank[0]/level-lbs</property>
						<value>150</value>
					</less-than>
					
			
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>fuelp</object-name>
    <condition>
      <equals>
      <property>controls/switches/fuel/tank/boost-pump</property>
	  <value>false</value>
	  </equals>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>fuelf</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/fuelf</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>servo</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/servo</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>hydr</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/hydr</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>emergxmit</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/emergxmit</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>GEN</object-name>
  <condition>
      <equals>
        <property>controls/electric/APU-generator</property>
        <value>1</value>
      </equals>
	  </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>batt</object-name>
    <condition>
	<equals>
       <property>controls/electric/directbat-switch</property>
	   <value>true</value>
	   </equals>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>inv</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/inv</property>
    </condition>
  </animation>
  
 <animation>
    <type>select</type>
    <object-name>pitot</object-name>
    <condition>
      <or>
        <greater-than>
          <property>sim/failure-manager/systems/pitot/failure-level</property>
          <value>0.3</value>
        </greater-than>
 
        <and>
          <less-than>
            <property>environment/temperature-degc</property>
            <value>4.0</value>
          </less-than>

          <not>
            <property>controls/anti-ice/pitot-heat</property>
			<value>true</value>
          </not>
        </and>
      </or>
    </condition>
  </animation>
  
 
    
  <animation>
    <type>select</type>
    <object-name>horn</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/horn</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>-</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/noideayet</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>mgbtemp</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/mgbtemp</property>
    </condition>
  </animation>
    
	<!--
  <animation>
    <type>select</type>
    <object-name>door</object-name>
    <condition>
      <or>
		<equals>
			<property>sim/model/bo105/doors/door[0]/enabled</property>
			
		</equals>

		<equals>
			<property>sim/model/bo105/doors/door[1]/enabled</property>
			
		</equals>
		
		
	   </or>
    </condition>
  </animation>
    -->
  <animation>
    <type>select</type>
    <object-name>gov</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/gov</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>engchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/engchip</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>mgbchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/mgbchip</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>tgbchip</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/tgbchip</property>
    </condition>
  </animation>

  <animation>
    <type>select</type>
    <object-name>engp</object-name>
    <condition>
	<not>
      <property>engines/engine/running</property>
	   <value>false</value>
	   </not>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>mgbp</object-name>
    <condition>
	<less-than>
      <property>rotors/gear/mgp-oil-pressure-bar</property>
	  <value>1.0</value>
	  </less-than>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>gov.001</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/redgov</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>engfire</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/engfire</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>batttemp</object-name>
    <condition>
      <property>instrumentation/annunciators/warning/battemp</property>
    </condition>
  </animation>
    
  <animation>
    <type>select</type>
    <object-name>twtgrip</object-name>
    <condition>
      <property>instrumentation/annunciators/cautions/twtgrip</property>
    </condition>
  </animation>
  
  
    
  <animation>
    <name>CWS</name>
    <object-name>fuel</object-name>
    <object-name>fuelp</object-name>
    <object-name>fuelf</object-name>
    <object-name>servo</object-name>
    <object-name>hydr</object-name>
    <object-name>emergxmit</object-name>
    <object-name>GEN</object-name>
    <object-name>batt</object-name>
    <object-name>inv</object-name>
    <object-name>pitot</object-name>
    <object-name>horn</object-name>
    <object-name>-</object-name>
    <object-name>mgbtemp</object-name>
    <object-name>door</object-name>
    <object-name>gov</object-name>
    <object-name>engchip</object-name>
    <object-name>mgbchip</object-name>
    <object-name>tgbchip</object-name>
    <object-name>engp</object-name>
    <object-name>mgbp</object-name>
    <object-name>gov.001</object-name>
    <object-name>engfire</object-name>
    <object-name>batttemp</object-name>
    <object-name>twtgrip</object-name>
  </animation>

 <animation>
    <type>select</type>
    <object-name>CWS</object-name>
    <condition>
	<or>
      <greater-than>
       <property>controls/electric/directbat-switch</property>
        <value>0</value>
      </greater-than>
	  
	   <equals>
        <property>controls/electric/APU-generator</property>
        <value>1</value>
      </equals>
	  
	  <not>
      <property>engines/engine/running</property>
	   <value>false</value>
	   </not>
	  
	  </or>
    </condition>
  </animation>

  <!--  REMBRANDT support for transparent objects -->
  <effect>
    <inherits-from>Effects/model-transparent</inherits-from>
    <object-name>fuel</object-name>
    <object-name>fuelp</object-name>
    <object-name>fuelf</object-name>
    <object-name>servo</object-name>
    <object-name>hydr</object-name>
    <object-name>emergxmit</object-name>
    <object-name>GEN</object-name>
    <object-name>batt</object-name>
    <object-name>inv</object-name>
    <object-name>pitot</object-name>
    <object-name>horn</object-name>
    <object-name>-</object-name>
    <object-name>mgbtemp</object-name>
    <object-name>door</object-name>
    <object-name>gov</object-name>
    <object-name>engchip</object-name>
    <object-name>mgbchip</object-name>
    <object-name>tgbchip</object-name>
    <object-name>engp</object-name>
    <object-name>mgbp</object-name>
    <object-name>gov.001</object-name>
    <object-name>engfire</object-name>
    <object-name>batttemp</object-name>
    <object-name>twtgrip</object-name>
    <condition>
      <property>sim/rendering/rembrandt/enabled</property>
    </condition>
  </effect>

</PropertyList>
