<?xml version="1.0"?>

<PropertyList>
	<path>torque.ac</path>
	<animation>
		<type>rotate</type>
		<object-name>Lneedle</object-name>
		<property>sim/model/bo105/torque-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>-204</dep></entry>
			<entry><ind>30</ind><dep>-144</dep></entry>
			<entry><ind>50</ind><dep>-105</dep></entry>
			<entry><ind>60</ind><dep>-87</dep></entry>
			<entry><ind>120</ind><dep>22</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	<animation>
		<type>rotate</type>
		<object-name>Rneedle</object-name>
		<property>sim/model/bo105/torque-pct</property>
		<interpolation>
			<entry><ind>0</ind><dep>-204</dep></entry>
			<entry><ind>30</ind><dep>-144</dep></entry>
			<entry><ind>50</ind><dep>-105</dep></entry>
			<entry><ind>60</ind><dep>-87</dep></entry>
			<entry><ind>120</ind><dep>22</dep></entry>
		</interpolation>
		<axis>
			<x>-1</x>
			<y>0</y>
			<z>0</z>
		</axis>
	</animation>
	
	 <animation>
    <type>material</type>
    <object-name>Rneedle</object-name>
   <object-name>Lneedle</object-name>
  
   <object-name>Face</object-name>
   <condition>
      <property>/controls/lighting/instrument-lights</property>
    </condition>
    <emission>
      <red>   0.80 </red>
      <green> 0.50 </green>
      <blue>  0.50 </blue>
    </emission>
   
  </animation>
</PropertyList>
