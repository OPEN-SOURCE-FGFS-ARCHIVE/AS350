	<!-- wx On/Off -->
 <animation>
		<type>pick</type>
		 <visible>true</visible>
		<object-name>ent</object-name>
		
		<action>
			<button>0</button>
			  <repeatable>true</repeatable>
			<binding>
				 <command>property-toggle</command>
				 <property>instrumentation/primus2000/dc840/mfd-wx</property>
			 
			</binding>
						<binding>
