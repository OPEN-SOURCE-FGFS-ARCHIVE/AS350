<?xml version="1.0" encoding="UTF-8"?>

<PropertyList>
<!-- G500H V3.  Now tied directly to your FG current version  FG1000 -->
 
<path>500h.ac</path>

<!-- right screen -->

 <model>
 <name>rightscreen</name>
   
	<path>Aircraft/Instruments-3d/FG1000/GDU104X/GDU-1040.1.xml</path>
    <offsets> 
     <x-m>0</x-m>
   <y-m>0</y-m>
   <z-m>0.006</z-m>
<pitch-deg>0</pitch-deg>

    </offsets>
	
	<overlay>
			
			 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.76</y-offset>
    <z-offset>1.175</z-offset>
   </animation>
		</overlay>

  </model>

	
		
<!-- left screen ( map screen ) -->

 <model>
 <name>leftscreen</name>
   
	<path>Aircraft/Instruments-3d/FG1000/GDU104X/GDU-1040.2.xml</path>
    <offsets>
      <x-m>0.00</x-m>
      <y-m>-0.205</y-m>
       <z-m>0.006</z-m>
      <roll-deg>    0.000 </roll-deg>
      <pitch-deg>   0.00 </pitch-deg>
      <heading-deg> 0.000 </heading-deg>
    </offsets>
	<overlay>
		 <animation n="400">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1.0</x-offset>
    <y-offset>0.88</y-offset>
      <z-offset>1.175</z-offset>
   </animation>
  </overlay>
  </model>	
  
  <animation>
    <type>material</type>
    <object-name>heading</object-name>
   <object-name>crs</object-name>
   <object-name>alt</object-name>
   <object-name>vs</object-name>
   <object-name>baro</object-name>
   <object-name>1</object-name>
   <object-name>2</object-name>
   <object-name>3</object-name>
   <object-name>4</object-name>
   <object-name>5</object-name>
   <object-name>6</object-name>
   <object-name>7</object-name>
    <object-name>8</object-name>
   <object-name>9</object-name>
   <object-name>10</object-name>
   <object-name>rangeup</object-name>
     <object-name>rangedown</object-name>
   <object-name>menu</object-name>
    <object-name>clr</object-name>
   <object-name>ent</object-name>
   <object-name>leftknob</object-name>
   <object-name>rightknob</object-name>
   <condition>
      <property>/controls/lighting/instrument-lights</property>
    </condition>
    <emission>
      <red>   0.80 </red>
      <green> 0.50 </green>
      <blue>  0.50 </blue>
    </emission>
   
  </animation>
  
  
    <animation>
        <type>select</type>
<object-name>leftscreen</object-name>	
<object-name>rightscreen</object-name>	
<condition>
					<or>
				
				  <property>controls/electric/directbat-switch</property>
                <equals>
                    <property>systems/electrical/suppliers/alternator</property>
                    <value>28</value>
                </equals>
				
				
		        
				</or>
				<and>
				<equals>
				<property>controls/electric/avionics-switch</property>
				<value>1</value>
				</equals>
				</and>
			</condition>

    </animation>
	
	
