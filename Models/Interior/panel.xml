  </model>


<model>

		<path>Aircraft/AS350/Models/Interior/Instruments/kma20/kma20.xml</path>
		<offsets>
		  <x-m> -4.732</x-m>
     <y-m>  -0.015 </y-m>
      <z-m>  -0.375 </z-m>
	   <pitch-deg>   -18.5 </pitch-deg>
		</offsets>
		<overlay>
		 <animation n="100">
    <type>scale</type>
    <property>constants/zero</property>
    <x-offset>1</x-offset>
    <y-offset>0.95</y-offset>
