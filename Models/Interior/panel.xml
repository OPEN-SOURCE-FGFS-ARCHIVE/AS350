   </animation>
  </overlay>
	</model>

 <model>

		<path>Aircraft/AS350/Models/Interior/Instruments/kx165/kx165-1.xml</path>
		<offsets>
		  <x-m> -4.68</x-m>
     <y-m>  -0.003 </y-m>
      <z-m>  -0.429 </z-m>
	   <pitch-deg>   -61 </pitch-deg>
		</offsets>

	</model>


	<model>

		<path>Aircraft/AS350/Models/Interior/Instruments/kx165/kx165-2.xml</path>
		<offsets>

			 <x-m> -4.635</x-m>
     <y-m>  -0.003 </y-m>
      <z-m>  -0.453 </z-m>
	   <pitch-deg>   -60 </pitch-deg>
		</offsets>

	</model>



</PropertyList>
